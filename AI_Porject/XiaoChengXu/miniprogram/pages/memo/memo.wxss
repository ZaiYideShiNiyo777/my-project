.page {
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom));
}

/* ---------- 分组切换 ---------- */
.group-switch {
  display: flex;
  background: #eef0f2;
  border-radius: 40rpx;
  padding: 6rpx;
  margin: 16rpx 24rpx 0;
}

/* 分段控件：图标+文字居中（覆盖 app.wxss 的文本居中） */
.segmented-item {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.seg-item-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.gs-item {
  flex: 1;
  height: 60rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  border-radius: 34rpx;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.gs-item-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
  flex-shrink: 0;
}

/* 邀请按钮：图标+文字居中 */
.invite-btn {
  display: flex;
  align-items: center;
  justify-content: center;
}

.invite-btn-icon {
  width: 22rpx;
  height: 22rpx;
  margin-right: 6rpx;
  flex-shrink: 0;
}

.gs-item.active {
  background: #fff;
  color: var(--primary);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.group-count {
  font-size: 20rpx;
  color: #b6bcc6;
  margin-left: 12rpx;
}

/* ---------- 时间线 ---------- */
.timeline {
  padding: 4rpx 0 24rpx;
}

.memo-item {
  display: flex;
  padding: 10rpx 32rpx;
}

.memo-item:active {
  background: rgba(30, 94, 255, 0.06);
}

.memo-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding-right: 16rpx;
}

.memo-content.mine {
  align-items: flex-end;
}

.bubble {
  max-width: 80%;
  background: var(--primary-light); /* 白色背景改为浅蓝色 */
  border-radius: 8rpx 24rpx 24rpx 24rpx;
  padding: 18rpx 26rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.bubble.mine {
  background: #a6c8ff;
  border-radius: 24rpx 8rpx 24rpx 24rpx;
}

.bubble.done {
  opacity: 0.55;
}

.bubble.done .bubble-text {
  text-decoration: line-through;
}

/* 气泡标题：完整展示，便于按标题快速识别 */
.bubble-title {
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
}

.bubble-title-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
  flex-shrink: 0;
}

.bubble-text {
  font-size: 28rpx;
}

.bubble-meta {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.bubble-tag {
  font-size: 20rpx;
  color: var(--primary);
  background: var(--primary-light);
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  margin-right: 10rpx;
}

.bubble-time {
  font-size: 20rpx;
  color: var(--text-sub);
  margin-left: auto;
}

.bubble-author {
  font-size: 20rpx;
  color: var(--text-sub);
  margin-right: 10rpx;
}

.longpress-tip {
  text-align: center;
  font-size: 20rpx;
  color: #c0c5cd;
  padding: 24rpx 0 8rpx;
}

/* ---------- 底部输入区 ---------- */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(124rpx + env(safe-area-inset-bottom)); /* 高于自定义 tabBar，避免被遮挡 */
  background: #fff;
  padding: 16rpx 24rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
  transition: bottom 0.15s ease-out;
}

/* 引用标题提示条 */
.refer-row {
  display: flex;
  align-items: center;
  background: var(--primary-light);
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
  margin-bottom: 12rpx;
}

.refer-pin-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.refer-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.refer-cancel {
  font-size: 22rpx;
  color: var(--text-sub);
  padding: 4rpx 8rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.refer-x-icon {
  width: 20rpx;
  height: 20rpx;
  margin-right: 4rpx;
}

.title-row {
  margin-bottom: 16rpx;
}

.title-input {
  width: 100%;
}

.input-row {
  display: flex;
  align-items: center;
}

.title-toggle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f2f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.title-toggle-icon {
  width: 32rpx;
  height: 32rpx;
}

.title-toggle.on {
  background: var(--primary-light);
}

/* 空状态图标（线条风） */
.empty-icon-img {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
}

.bottom-input {
  flex: 1;
}

.send-btn {
  margin-left: 16rpx;
  flex-shrink: 0;
}
